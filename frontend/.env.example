# Voice Mock Test - frontend settings
# Copy this file to "frontend/.env" if you need to change anything.

# Where the React app sends API calls.
# Development: keep /api (Vite forwards it to Django).
# Production: the full address, for example https://api.your-domain.com/api
VITE_API_URL=/api

# Django address used by the Vite development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8000
