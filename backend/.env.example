# =====================================================================
#  Voice Mock Test System - backend settings
#  This file lives in the backend folder. Copy it to "backend/.env".
#  Never share or commit your real .env file.
# =====================================================================

# --- Django ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kathmandu
LOG_LEVEL=INFO

# --- Frontend address (used in email links and CORS) -----------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------
# Empty = SQLite file backend/db.sqlite3 (works straight away).
# PostgreSQL on your computer:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/voice_mock_test
# Supabase (Connect > Session pooler, port 5432):
# DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- First admin account (created by "python manage.py migrate") -----
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Admin

# --- Google sign-in --------------------------------------------------
# Paste your OAuth "Web application" client ID here to show "Continue with Google".
# Example: 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# --- Accounts --------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=True
INVITE_VALID_DAYS=7
PASSWORD_RESET_VALID_HOURS=1
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Sign-in, sign-up and password-reset requests allowed per minute from one network address.
THROTTLE_AUTH=30/min

# --- Recordings storage ----------------------------------------------
# local = backend/media (development)   s3 = Supabase Storage or AWS S3
STORAGE_BACKEND=local
MAX_AUDIO_UPLOAD_MB=15
# S3_BUCKET_NAME=recordings
# S3_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
# S3_REGION_NAME=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Speech scoring --------------------------------------------------
# True = sample scores without calling any AI service (no keys needed).
EVALUATION_DEMO_MODE=True
# Which AI service scores answers when demo mode is off:
#   groq   = FREE. One key from https://console.groq.com/keys does speech-to-text and feedback.
#   openai = OpenAI speech-to-text + Anthropic Claude feedback (paid, two keys below).
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_SCORING_MODEL=openai/gpt-oss-120b
# Only for AI_PROVIDER=openai:
OPENAI_API_KEY=
# whisper-1 retires on 26 Feb 2027. After that use: TRANSCRIBE_MODEL=gpt-transcribe
TRANSCRIBE_MODEL=whisper-1
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-5-5
AI_REQUEST_TIMEOUT=60
SCORE_WEIGHT_FLUENCY=40
SCORE_WEIGHT_PRONUNCIATION=30
SCORE_WEIGHT_GRAMMAR=30
REVIEW_THRESHOLD=65

# --- Email -----------------------------------------------------------
# The console backend prints emails in the backend window. For real email use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Voice Mock Test <no-reply@example.com>
# django = Django sends every email. n8n = invitations and resets go through n8n webhooks.
EMAIL_DELIVERY=django

# --- Optional: n8n automations ---------------------------------------
AUTOMATION_API_KEY=
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
